# Sift Environment Configuration

# Backend API configuration
HOST=127.0.0.1
PORT=8000

# Path to the mounted NAS SMB share on the host machine
NAS_HOST_PATH=/mnt/big-storage
NAS_MOUNT_PATH=/mnt/big-storage

# LM Studio REST API endpoint (OpenAI compatible)
LM_STUDIO_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=local-model

# SearXNG Meta Search engine JSON API endpoint
SEARXNG_URL=http://localhost:8080

# Database configuration (PostgreSQL 15 in Docker Compose, fallback to SQLite for local pytest/standalone dev)
POSTGRES_USER=sift
POSTGRES_PASSWORD=siftpass
POSTGRES_DB=siftdb
DATABASE_URL=sqlite:///./sift.db
